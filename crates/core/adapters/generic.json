{
  "name": "generic",
  "source": "Webhook",
  "setup": [
    "Post events with:",
    "  curl -X POST {public}/hook/{endpoint} -H 'Authorization: Bearer <token>' -d '{\"title\":\"Backup finished\",\"summary\":\"12 GB copied\"}'",
    ""
  ],
  "rules": [
    {
      "when": {},
      "kind": "{/kind ?? 'info'}",
      "priority": "{/priority ?? 'normal'}",
      "title": "{/title ?? /subject ?? /name ?? 'Notification'}",
      "text": "{/summary ?? /text ?? /message ?? /body}",
      "status": "{/status}",
      "session_ref": "{/session_ref ?? /session_id}"
    }
  ]
}
