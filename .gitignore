# Build
/target/
**/*.rs.bk

# Local config and secrets (ship config.example.toml only)
config.toml
*.local.toml
.env
.env.*
secrets/
# Bridge secrets and local settings (the examples in bridges/examples are committed)
bridges/deploy/*.env
bridges/deploy/*.toml
__pycache__/
*.pyc

# Runtime data
/data/
*.log

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Tooling (shared agent settings and hooks in .claude/ ARE committed; only local overrides are ignored)
.claude/settings.local.json
.claude/*.local.*
.run/

# Portal (Node is a dev and CI tool only; the built page is committed)
/portal/node_modules/
/portal/lint/node_modules/

# Stray build directories from older scripts/cargo.sh runs in linked worktrees
/-agent-*

# Local voice loop runs
/clawdot-pc.json
/clawdot-data/
/clawdot-core.log*
