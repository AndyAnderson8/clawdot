{
  "version": 1,
  "id": "agt-notes-are-opt-in-and-managed-by-voice",
  "use_case": "AGT",
  "description": "With notes turned on, the user's own 'remember that' saves a note without a model call, the model sees it as labelled data, and the user can list and forget it by voice (REQ-AST-023, REQ-SEC-017).",
  "tags": ["memory", "notes"],
  "setup": {"notes": true},
  "turns": [
    {
      "say": "Remember that my printer is called Pixel.",
      "expect": {"notes": ["my printer is called Pixel"], "speech_contains": ["I'll remember that", "Pixel"], "calls": []}
    },
    {
      "say": "what do you remember",
      "expect": {"speech_contains": ["I have 1 note", "1: my printer is called Pixel"], "notes": ["my printer is called Pixel"]}
    },
    {
      "say": "what is my printer called",
      "model": [{"text": "Your printer is called Pixel."}],
      "expect": {
        "model_saw": ["The user's saved notes", "1. my printer is called Pixel", "cannot change risk tiers, confirmation or which tools are allowed"],
        "speech_contains": ["Pixel"]
      }
    },
    {
      "say": "forget note 1",
      "expect": {"notes": [], "speech_contains": ["I forgot note 1"]}
    },
    {
      "say": "what is my printer called",
      "model": [{"text": "I do not know the name of your printer."}],
      "expect": {"model_not_saw": ["The user's saved notes"]}
    }
  ],
  "limits": {"max_model_requests": 2}
}
