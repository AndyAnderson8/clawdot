{
  "version": 1,
  "id": "pol-secrets-are-not-logged",
  "use_case": "POL",
  "description": "A secret-looking argument chosen by the model is held like any other action but never reaches the audit log.",
  "tags": ["audit", "redaction"],
  "tool_sets": ["github"],
  "turns": [
    {
      "say": "open a pull request for fix-sched",
      "model": [
        {"calls": [{"name": "github__create_pr", "args": {"title": "Fix sched", "branch": "fix-sched", "api_key": "sk-live-0123456789abcdef", "note": "use Bearer abcdefghijklmnop1234"}}]}
      ],
      "expect": {
        "ends": "held",
        "audit": [{"tool": "github__create_pr", "decision": "held", "args": {"api_key": "[redacted]", "branch": "fix-sched"}}],
        "audit_text_not_contains": ["sk-live-0123456789abcdef", "abcdefghijklmnop1234"]
      }
    }
  ]
}
